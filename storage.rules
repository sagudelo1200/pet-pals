rules_version = '2';

// Firebase Storage de Paw-Path.
//
// Todo está denegado salvo las rutas de abajo. Cada clase de archivo tiene su
// perfil en functions/src/compartido/archivos.ts (PERFILES_ARCHIVO) y su bloque
// aquí, con los mismos límites de tamaño, tipo y nombre; un test comprueba que
// coinciden. Un uso nuevo = un perfil + un bloque + una ruta.
//
// Los archivos privados se leen en el servidor (Admin SDK): al admin se le
// entregan URLs firmadas de vida corta, por eso aquí no hay lectura de admin
// (evitaría una consulta a Firestore en cada lectura).
service firebase.storage {
  match /b/{bucket}/o {

    // Perfil `evidencia`: DOCUMENTOS DE LA HABILITACIÓN DEL CUIDADOR (identidad, ...)
    //   habilitaciones/{uid}/{servicio}/{requisito}/{archivo}
    // El dueño sube, reemplaza, lee y borra lo suyo. Un nombre fijo por
    // archivo (frente, reverso...) hace que reemplazar no acumule copias.
    match /habilitaciones/{uid}/{servicio}/{requisito}/{archivo} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && archivo.matches('[a-z0-9_]{1,30}')
        && request.resource.size <= 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)|application/pdf');
    }

    // Perfil `foto_entrega`: FOTO DEL GRUPO AL TERMINAR UN PASEO
    //   paseos/{paseoId}/entrega/{archivo}
    // La sube el cuidador asignado a ese paseo mientras está en curso o recién
    // finalizado; la leen el cuidador y quien lo pidió. Consulta el paseo en
    // Firestore (una lectura por subida) para saber quién es quién.
    match /paseos/{paseoId}/entrega/{archivo} {
      function paseo() {
        return firestore.get(/databases/(default)/documents/operaciones/$(paseoId)).data;
      }
      allow read: if request.auth != null
        && (paseo().id_cuidador == request.auth.uid
          || paseo().creado_por == request.auth.uid);
      allow create, update: if request.auth != null
        && paseo().tipo == 'paseo'
        && paseo().id_cuidador == request.auth.uid
        && paseo().estado in ['EN_PROGRESO', 'FINALIZADO']
        && archivo.matches('[a-z0-9_]{1,30}')
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    // Todo lo demás: denegado
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

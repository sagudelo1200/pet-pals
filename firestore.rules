rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // HELPERS GLOBALES

    // Indica si la peticion proviene de un usuario autenticado
    function autenticado() {
      return request.auth != null;
    }

    // Devuelve documento usuarios del uid autenticado
    function doc_usuario() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // Verifica si hay roles en el token (Custom Claims)
    function tiene_rol_en_claims(rol) {
      return request.auth.token.roles != null && (
      (request.auth.token.roles is list && request.auth.token.roles.hasAny([rol])) ||
      (request.auth.token.roles is map && request.auth.token.roles[rol] == true)
      );
    }

    // Verifica si hay roles en un documento de usuario
    function tiene_rol_en_doc(d, rol) {
      return d != null && d.data.roles != null && (
      (d.data.roles is list && d.data.roles.hasAny([rol])) ||
      (d.data.roles is map && d.data.roles[rol] == true)
      );
    }

    // Comprueba si el usuario u tiene el rol rol
    // OPTIMIZADO: Primero verifica claims (gratis), luego documento (costoso)
    function tiene_rol(u, rol) {
      return autenticado() && (
      // Si es el usuario actual, verificar claims primero (sin get)
      (u == request.auth.uid && tiene_rol_en_claims(rol)) ||
      // Si claims no tiene el rol, verificar en documento
      (u == request.auth.uid && tiene_rol_en_doc(doc_usuario(), rol)) ||
      // Si es otro usuario, verificar su documento
      (u != request.auth.uid && tiene_rol_en_doc(get(/databases/$(database)/documents/usuarios/$(u)), rol))
      );
    }

    // Verifica si el usuario autenticado tiene un rol especifico
    // OPTIMIZADO: Usa claims primero
    function tiene_rol_actual(rol) {
      return autenticado() && (tiene_rol_en_claims(rol) || tiene_rol_en_doc(doc_usuario(), rol));
    }

    // Verifica si el usuario autenticado es administrador
    function es_admin() {
      return autenticado() && tiene_rol_actual('admin');
    }

    // Comprueba si el UID corresponde al usuario autenticado
    function es_mismo_uid(u) {
      return autenticado() && u == request.auth.uid;
    }

    // Comprueba si el documento pertenece al usuario autenticado
    function es_tutor() {
      return autenticado() &&
      resource != null &&
      resource.data.creado_por == request.auth.uid;
    }

    // Verifica que el payload declara correctamente el creador
    function es_creador() {
      return autenticado() &&
      request.resource.data.creado_por == request.auth.uid;
    }

    // CAMPOS SISTEMA VALIDACIONES

    function tiene_campos_sistema_basicos() {
      return request.resource.data.keys().hasAll([
      'id', 'creado_por', 'actualizado_por', 'creado_en', 'actualizado_en'
      ]);
    }

    function campos_sistema_validos_crear() {
      return request.resource.data.creado_en == request.time &&
      request.resource.data.actualizado_en == request.time &&
      request.resource.data.creado_por == request.auth.uid &&
      request.resource.data.actualizado_por == request.auth.uid;
    }

    function campos_sistema_validos_actualizar() {
      return request.resource.data.creado_en == resource.data.creado_en &&
      request.resource.data.creado_por == resource.data.creado_por &&
      request.resource.data.actualizado_en == request.time &&
      request.resource.data.actualizado_por == request.auth.uid;
    }

    function solo_campos_permitidos(camposPermitidos) {
      return request.resource.data.keys().hasOnly(camposPermitidos);
    }

    // PASEOS HELPERS ESPECIFICOS

    function estado_permite_unirse(estado) {
      return estado in ['pendiente', 'confirmado'];
    }

    function es_actor_paseo_doc(p) {
      return autenticado() && p != null && (
      p.data.creado_por == request.auth.uid ||
      p.data.id_cuidador == request.auth.uid ||
      es_admin()
      );
    }

    function puede_unirse_a_paseo_doc(p) {
      // Solo paseos con modalidad 'compartido' permiten que OTROS tutores se unan
      return p != null && p.data.modalidad == 'compartido' && estado_permite_unirse(p.data.estado);
    }

    // Helper para obtener documento de paseo (reutilizable en subcolecciones)
    function get_paseo_doc(paseoId) {
      return get(/databases/$(database)/documents/paseos/$(paseoId));
    }

    // Validar transiciones de estado permitidas para cuidador
    function transicion_estado_valida(estadoActual, estadoNuevo) {
      return (
      (estadoActual == 'PENDIENTE' && estadoNuevo == 'CONFIRMADO') ||
      (estadoActual == 'CONFIRMADO' && estadoNuevo == 'EN_CAMINO') ||
      (estadoActual == 'EN_CAMINO' && estadoNuevo == 'EN_PROGRESO') ||
      (estadoActual == 'EN_PROGRESO' && estadoNuevo == 'FINALIZADO') ||
      (estadoActual == 'FINALIZADO' && estadoNuevo == 'COMPLETADO')
      );
    }

    // USUARIOS
    match /usuarios/{uid} {
      allow read: if autenticado() && (es_mismo_uid(uid) || es_admin());
      allow create: if autenticado() && es_mismo_uid(uid)
        && es_creador()
        && tiene_campos_sistema_basicos()
        && campos_sistema_validos_crear();
      allow update: if autenticado() && (es_mismo_uid(uid) || es_admin())
        && campos_sistema_validos_actualizar();
      allow delete: if es_admin();
    }

    // PERFIL PUBLICO
    match /perfil_publico/{docId} {
      // Permitir lectura a cualquier usuario autenticado o si el perfil es verificado (público)
      allow read: if autenticado() || resource.data.verificacion == 'verificado';

      allow create: if autenticado()
        && (request.resource.data.creado_por == request.auth.uid || es_admin())
        && tiene_campos_sistema_basicos()
        && campos_sistema_validos_crear();

      allow update: if autenticado()
        && (resource.data.creado_por == request.auth.uid || es_admin())
        && campos_sistema_validos_actualizar();

      allow delete: if es_admin();
    }

    // MASCOTAS
    match /mascotas/{id} {
      // Permitir lectura si es tutor (dueño), admin, o si es cuidador (para ver detalles en solicitudes)
      allow read: if autenticado() && (es_tutor() || es_admin() || tiene_rol_actual('cuidador'));
      allow create: if autenticado()
        && es_creador()
        && tiene_campos_sistema_basicos()
        && campos_sistema_validos_crear();
      allow update: if autenticado()
        && es_tutor()
        && campos_sistema_validos_actualizar()
        && request.resource.data.creado_por == resource.data.creado_por
        && request.resource.data.id == resource.data.id
        && solo_campos_permitidos([
      'id', 'nombre', 'raza', 'edad', 'descripcion', 'foto', 'especie', 'genero',
      'peso', 'tamano', 'nivel_energia', 'fecha_nacimiento', 'esterilizado',
      'vacunas', 'condiciones_salud', 'condiciones_comportamiento', 'activo',
      'preferencias_paseo', 'historial_medico',
      'creado_por', 'creado_en', 'actualizado_en', 'actualizado_por'
      ]);
      allow delete: if autenticado() && (es_tutor() || es_admin());
    }

    // UBICACIONES (direcciones geocodificadas)
    match /ubicaciones/{id} {

      // Lectura: cualquier usuario autenticado puede leer ubicaciones (se puede endurecer si hace falta)
      allow read: if autenticado();

      // Crear: validaciones sin campos_sistema_validos_crear
      // (serverTimestamp no se puede comparar con request.time en reglas)
      // Las coordenadas GeoPoint se validan en el código del servicio
      allow create: if autenticado()
        && es_creador()
        && tiene_campos_sistema_basicos()
        && request.resource.data.proveedor in ['google','mapbox']
        && request.resource.data.proveedor_place_id is string
        && request.resource.data.proveedor_place_id.size() > 0
        && request.resource.data.direccion_formateada is string
        && request.resource.data.direccion_formateada.size() > 3;

      // Update: el creador o admin puede actualizar. Mantener campos de sistema y no cambiar creado_por/creado_en.
      allow update: if autenticado() && (es_admin() || resource.data.creado_por == request.auth.uid)
        && campos_sistema_validos_actualizar()
        && request.resource.data.creado_por == resource.data.creado_por
        && request.resource.data.creado_en == resource.data.creado_en
        && solo_campos_permitidos([
      'id','proveedor','proveedor_place_id','direccion_formateada','coordenadas',
      'componentes','componentes_raw','componentes_source','viewport','alias','instrucciones',
      'metadata','estado','creado_por','creado_en','actualizado_en','actualizado_por'
      ]);

      // Solo admin puede borrar
      allow delete: if es_admin();
    }

    // PASEOS
    match /paseos/{id} {
      // OPTIMIZADO: Validaciones baratas primero
      // Permitir lectura si:
      // 1. Eres actor del paseo (creador o cuidador asignado)
      // 2. El paseo está PENDIENTE y no tiene cuidador asignado (para que cuidadores puedan ver solicitudes)
      allow get: if autenticado() && (
      resource == null || 
      resource.data.creado_por == request.auth.uid ||
      resource.data.id_cuidador == request.auth.uid ||
      (resource.data.estado == 'PENDIENTE' && (!('id_cuidador' in resource.data) || resource.data.id_cuidador == null))
      );

      allow list: if autenticado() && (
      resource.data.creado_por == request.auth.uid ||
      resource.data.id_cuidador == request.auth.uid ||
      (resource.data.estado == 'PENDIENTE' && (!('id_cuidador' in resource.data) || resource.data.id_cuidador == null))
      );

      allow create: if autenticado()
        && es_creador()
        && tiene_campos_sistema_basicos()
        && campos_sistema_validos_crear()
      // Validar que el cuidador no sea el mismo que el creador
        && (!('id_cuidador' in request.resource.data) || 
      request.resource.data.id_cuidador != request.auth.uid);

      // OPTIMIZADO: Validaciones en orden de costo (baratas primero)
      allow update: if autenticado() && campos_sistema_validos_actualizar() && (
      // Caso 1: El Creador actualiza (validación más barata - solo request.auth.uid)
      resource.data.creado_por == request.auth.uid ||

      // Caso 2: Aceptar solicitud (PENDIENTE -> CONFIRMADO)
      (
      resource.data.estado == 'PENDIENTE' &&
      request.resource.data.estado == 'CONFIRMADO' &&
      request.resource.data.id_cuidador == request.auth.uid &&
      (!('id_cuidador' in resource.data) || resource.data.id_cuidador == null || resource.data.id_cuidador == request.auth.uid)
      ) ||

      // Caso 3: El Cuidador asignado actualiza estado (con validación de transición)
      (
      resource.data.id_cuidador == request.auth.uid &&
      request.resource.data.id_cuidador == request.auth.uid &&
      (
      // Si cambia el estado, validar transición
      (request.resource.data.estado != resource.data.estado && 
      transicion_estado_valida(resource.data.estado, request.resource.data.estado)) ||
      // Si no cambia el estado, permitir otros cambios
      request.resource.data.estado == resource.data.estado
      )
      ) ||

      // Caso 4: Admin (más costoso - requiere verificar claims/doc)
      es_admin()
      );

      allow delete: if es_actor_paseo_doc(resource);
    }

    // SUBCOLECCION PASEOS MASCOTAS
    match /paseos/{paseoId}/mascotas/{mascotaId} {

      function es_tutor_mascota() {
        return resource != null && resource.data.id_usuario == request.auth.uid;
      }

      // OPTIMIZADO: Verificar autenticado primero, luego es_tutor_mascota (barato), finalmente get()
      allow read: if autenticado() && (
      es_tutor_mascota() || 
      es_actor_paseo_doc(get_paseo_doc(paseoId))
      );

      // OPTIMIZADO: Validaciones baratas primero
      allow create: if autenticado() &&
      tiene_campos_sistema_basicos() &&
      campos_sistema_validos_crear() &&
      (
      // Primero verificar si es el usuario que se está agregando (barato)
      (request.resource.data.id_usuario == request.auth.uid && 
      request.resource.data.id_mascota == mascotaId &&
      puede_unirse_a_paseo_doc(get_paseo_doc(paseoId))) ||
      // Luego verificar si es actor (requiere get)
      es_actor_paseo_doc(get_paseo_doc(paseoId))
      );

      // Actor o tutor puede actualizar observaciones
      allow update: if (
      (es_actor_paseo_doc(get_paseo_doc(paseoId))
        && campos_sistema_validos_actualizar()
        && request.resource.data.id_mascota == resource.data.id_mascota
        && request.resource.data.id_usuario == resource.data.id_usuario)
        ||
      (es_tutor_mascota()
        && campos_sistema_validos_actualizar()
        && request.resource.data.id_paseo == resource.data.id_paseo
        && request.resource.data.id_mascota == resource.data.id_mascota
        && request.resource.data.id_usuario == resource.data.id_usuario
        && request.resource.data.estado_mascota == resource.data.estado_mascota
        && request.resource.data.codigo_recogida == resource.data.codigo_recogida
        && request.resource.data.codigo_entrega == resource.data.codigo_entrega
        && request.resource.data.actualizado_por == request.auth.uid)
      );

      allow delete: if es_actor_paseo_doc(get_paseo_doc(paseoId));
    }

    // SUBCOLECCION DE EVENTOS (HISTORIAL)
    match /paseos/{paseoId}/eventos/{eventoId} {
      // OPTIMIZADO: Verificar autenticado primero, luego get()
      allow read: if autenticado() && es_actor_paseo_doc(get_paseo_doc(paseoId));

      // OPTIMIZADO: Validaciones baratas primero (campos), luego get()
      allow create: if autenticado() &&
      request.resource.data.keys().hasAll(['evento','payload','actor','creado_en']) &&
      request.resource.data.actor == request.auth.uid &&
      request.resource.data.creado_en == request.time &&
      es_actor_paseo_doc(get_paseo_doc(paseoId));

      // Solo admin puede modificar o borrar eventos
      allow update, delete: if es_admin();
    }
  }
}

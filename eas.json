{
  "cli": {
    "version": ">= 16.26.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "android": {
        "buildType": "app-bundle",
        "keystore": {
          "keystorePath": "android/app/release.keystore",
          "keystorePassword": "REDACTED",
          "keyAlias": "pawpath",
          "keyPassword": "REDACTED"
        }
      }
    }
  },
  "submit": {
    "production": {}
  }
}
